# Neon Postgres. Get these from your Neon project dashboard -> Connection Details.
# DATABASE_URL: pooled connection (via PgBouncer, port 5432 with "-pooler" in host) - used by the app at runtime.
# DIRECT_URL: unpooled direct connection - used by Prisma Migrate (migrations need a direct connection, not pooled).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/typ?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/typ?sslmode=require"

# Auth.js - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (NOT `npx auth secret` - that resolves to the unrelated "Better Auth" package
# and prints a BETTER_AUTH_SECRET var name this project doesn't use.)
AUTH_SECRET=""

# Paystack (test mode keys from https://dashboard.paystack.com/#/settings/developers).
# Until these are set, lib/payments/paystack.ts throws a clear "not configured"
# error instead of attempting a doomed live API call - checkout/webhook code
# is safe to deploy without keys, it just can't complete a real charge yet.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# Base URL Paystack redirects back to after checkout (e.g. http://localhost:3000
# in dev, your real domain in production) - used to build the callback_url.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend (get a key from https://resend.com/api-keys). Until this is set,
# lib/email/resend.ts throws a clear "not configured" error instead of
# attempting a doomed live API call - every email-sending flow is safe to
# deploy without a key, it just can't actually deliver mail yet (most
# callers catch this and fall back to displaying the info in-app instead).
RESEND_API_KEY=""
# Must be a verified sender on your Resend account (their own domain
# onboarding covers this) - "onboarding@resend.dev" works for dev/testing
# without verifying a custom domain.
EMAIL_FROM="TYP <onboarding@resend.dev>"

# Sentry (get a DSN from https://sentry.io - create a Next.js project).
# Used by both instrumentation.ts (server) and instrumentation-client.ts
# (browser) - NEXT_PUBLIC_ prefixed since the client-side init needs it
# embedded in the browser bundle, same as every other NEXT_PUBLIC_ var in
# this file. Until this is set, Sentry.init() is never called on either side
# - the SDK stays fully inert (no errors captured, nothing sent anywhere),
# same "safe to ship without real keys" pattern as Paystack/Resend/Upstash.
NEXT_PUBLIC_SENTRY_DSN=""
# Optional, build-time only - lets `next build` upload real source maps to
# Sentry so stack traces resolve to actual source lines instead of minified
# code. Without these, the build still succeeds; it just skips the upload
# with a warning (verified directly, see docs/build-log.md).
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Upstash Redis (get these from https://console.upstash.com - a REST-based
# Redis, needed because Vercel's serverless model has no shared in-memory
# state across instances). Powers rate limiting on login/signup/**/
# forgot-password/contact (lib/rate-limit.ts). Until these are set, the rate
# limiter fails OPEN (see lib/rate-limit.ts's own comment for the full
# reasoning) - every guarded route stays fully usable, just without abuse
# protection, same as this app's state before this feature existed.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Brevo (get an API key from https://app.brevo.com/settings/keys/api).
# Powers the newsletter signup form on /contact (lib/newsletter/brevo.ts).
# Until BREVO_API_KEY is set, subscribing throws a clear "not configured"
# error instead of attempting a doomed live API call - same "safe to ship
# without real keys" pattern as Paystack/Resend/Upstash/Sentry.
BREVO_API_KEY=""
# The numeric ID of the Brevo contact list new subscribers get added to -
# find/create one at https://app.brevo.com/contact/list-manage. Required
# alongside BREVO_API_KEY; there's no sane default since it's specific to
# your Brevo account.
BREVO_NEWSLETTER_LIST_ID=""

# Mux (platform-hosted lesson video, decided 2026-08-17, confirmed with the
# user - a tutor's alternative to pasting an external YouTube/Vimeo link).
# Get MUX_TOKEN_ID/MUX_TOKEN_SECRET from a real Mux account: Settings ->
# API Access Tokens -> Generate new token (needs Mux Video read+write).
# MUX_WEBHOOK_SECRET comes from Settings -> Webhooks -> your endpoint's
# signing secret (endpoint URL: <your domain>/api/webhooks/mux). Until these
# are set, lib/video/mux.ts's calls throw a clear "not configured" error -
# same "safe to ship without real keys" pattern as every other integration
# here.
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
MUX_WEBHOOK_SECRET=""

# Daily.co (native in-app video calling for tutor virtual sessions, decided
# 2026-08-17, confirmed with the user). Get from a real Daily.co account:
# Developers -> API keys. Until this is set, lib/video/daily.ts's calls
# throw a clear "not configured" error - same pattern as the rest of this
# file.
DAILY_API_KEY=""

# Google Search Console site-ownership verification (get the "content" value
# from the meta-tag verification method at
# https://search.google.com/search-console -> Add Property -> URL prefix ->
# HTML tag). Optional - until this is set, app/layout.tsx simply omits the
# verification meta tag, same "safe to ship without keys" pattern as the
# other vars in this file.
GOOGLE_SITE_VERIFICATION=""

# Verifies that requests to /api/cron/* actually came from Vercel Cron, not
# an arbitrary caller - Vercel automatically sends this as
# `Authorization: Bearer $CRON_SECRET` when the project has this env var set
# (see vercel.json's crons config). Generate with the same command as
# AUTH_SECRET above. Optional in dev - the cron route skips the check if this
# is unset, so it stays manually testable without provisioning one first.
CRON_SECRET=""

# Firebase Cloud Messaging (mobile push notifications, decided 2026-08-16,
# confirmed with the user first). Powers lib/push/fcm.ts, which sends exam-
# related pushes (new exam assigned, results ready) to the mobile app -
# mobile v1 is student-only, so this only ever targets students. Get this
# from a real Firebase project: console.firebase.google.com -> Project
# Settings -> Service Accounts -> Generate new private key - paste the
# entire downloaded JSON file's contents here as a single-line string.
# Until this is set, lib/push/fcm.ts's send calls throw a clear "not
# configured" error that every caller catches best-effort - same "safe to
# ship without real keys" pattern as Paystack/Resend/Upstash/Sentry/Brevo.
# The mobile app's own half of this (mobile/lib/firebase_options.dart) is a
# separate, mobile-side setup step - see that file's own doc comment.
FIREBASE_SERVICE_ACCOUNT_JSON=""
